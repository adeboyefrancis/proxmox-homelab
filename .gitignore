# Local secret files
*.tfvars
*.tfvars.json

# Terraform runtime directories
.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# Packer files to ignore
*.pkrvars.hcl
*.pkrvars.json
*.auto.pkrvars.hcl
*.auto.pkrvars.json
.packer.d/plugins/
crash.log
packer_cache/
output-*/
*.box
manifest.json

# Draft files
local-draft.md
notes/


# ── Machine-generated junk (no one commits these) ───────────────
# Compiled binaries / local runtime state
app/quicknotes
app/data/
/quicknotes
*.exe

# Vagrant runtime state  — the Vagrantfile IS committed; .vagrant/ is not
.vagrant/

# Nix build symlinks — flake.nix + flake.lock ARE committed; result is not
result
result-*

# Refs
refs/

# Gitleaks result
results.json
