#cloud-config
autoinstall:
  version: 1
  refresh-installer:
    update: false

  locale: en_US.UTF-8
  keyboard:
    layout: us

  network:
    version: 2
    ethernets:
      ens18:
        dhcp4: true

  storage:
    layout:
      name: lvm

  identity:
    hostname: ubuntu-golden-template
    username: ubuntu
    password: "$6$ods1FlTjA/ie/juf$BwBJCflNVhaMsFTkG3K58HxEnEHgC6oHzYfVmRBRt5.BKmltJTUfGkbEXs7oD2fBNTk/CDOc9RLx3aqFi34ne0"
    realname: "Packer Build User"

  ssh:
    install-server: true
    authorized-keys:
      - "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIDo2WQZX+u2qZGMhjy71qTBEA3USJr3JhSLMnJSY5V5h proxmox-terraform"
    allow-pw: true

  packages:
    - qemu-guest-agent
    - openssh-server

  late-commands:
    - "echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/ubuntu-build"
    - "chmod 440 /target/etc/sudoers.d/ubuntu-build"
    - "curtin in-target -- systemctl enable qemu-guest-agent"

  # This is the correct sub-property layout Subiquity expects
  user-data:
    disable_root: true
